PORT=5001
ADMIN_EMAIL=admin@ellangala.com
ADMIN_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ellangala

# Razorpay — required for "Pay Online" at checkout. Without these the checkout
# falls back to Cash on Delivery only.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# Optional — defaults to the local Postfix relay (no auth) if unset.
# Set these once real SMTP credentials (e.g. Zoho) are available.
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=orders@ellangala.com
# SMTP_PASS=change-me
# MAIL_FROM="Ellangala's Academy" <orders@ellangala.com>
