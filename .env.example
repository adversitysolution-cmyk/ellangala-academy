PORT=5001
ADMIN_EMAIL=admin@ellangala.com
ADMIN_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ellangala

# Razorpay — required for "Pay Online" at checkout. Without these the checkout
# falls back to Cash on Delivery only.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# Public origin used to build certificate QR codes and verification links
# (e.g. https://ellangala.com). Defaults to a relative URL if unset.
PUBLIC_BASE_URL=https://ellangala.com

# Outbound email. Without these it falls back to a local relay on port 25
# (usually blocked on a VPS). Use the cPanel mail host — port 465 is implicit
# TLS and validates against the ellangala.com certificate.
# SMTP_HOST=ellangala.com
# SMTP_PORT=465
# SMTP_USER=info@ellangala.com
# SMTP_PASS=change-me
# MAIL_FROM="Ellangala's Academy" <info@ellangala.com>
